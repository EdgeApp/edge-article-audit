# Intercom API Configuration
# Copy this file to .env and fill in your values

# Required: Your Intercom access token
INTERCOM_ACCESS_TOKEN=your_access_token_here

# Optional: API server (default: https://api.intercom.io)
# Use https://api.eu.intercom.io for EU or https://api.au.intercom.io for AU
INTERCOM_SERVER=https://api.intercom.io

# Optional: API version (default: 2.14)
INTERCOM_VERSION=2.14

# Optional: Default locale for articles (default: en)
INTERCOM_DEFAULT_LOCALE=en
